APP_ENV=local
PORT=8000
DATABASE_URL=postgresql+psycopg://labseat:localonly@localhost:5432/labseat
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.local/images
COOKIE_SECURE=false
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
# Supply SEED_PASSWORD at runtime only. No real secrets in this file.

# All application nodes use one worker and the same bounded pool.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
# Local-only plaintext Redis; production requires rediss:// and a trusted CA.
# Queue enabled/policy/epoch live in DB, not in a per-instance QUEUE_ENABLED variable.
REDIS_URL=redis://redis:6379/0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_OPERATOR_USERNAME=
REDIS_OPERATOR_PASSWORD=
REDIS_CA_PATH=
REDIS_CONNECT_TIMEOUT_MS=300
REDIS_COMMAND_TIMEOUT_MS=500
REDIS_MAX_CONNECTIONS=4

# Local Compose events profile uses ElasticMQ + mock email, no real AWS credentials.
# AWS ECS environment supplies SQS_QUEUE_URL/AWS_REGION and Brevo sender/API-key settings; no static AWS keys.
EMAIL_BACKEND=mock
# Release tags must be unique. Deployment scripts require AWS_PROFILE/AWS_REGION/EXPECTED_AWS_ACCOUNT_ID.
# DEPLOY_TIMEOUT_SECONDS=900
# TASK_TIMEOUT_SECONDS=300

# Brevo sender/site settings: see .env.brevo.example and compose.brevo.yaml (explicit opt-in).
# Never put a real API key in this file or in the image.

# Shared API/worker signing secret >=32 chars. Local has a development fallback only.
AUTH_LINK_SIGNING_KEY=
# Authenticate provider callback; never send this token to browser clients.
BREVO_WEBHOOK_TOKEN=
# Pub/Sub uses separate ACL/credentials in production (not queue runtime credentials).
REDIS_EVENTS_URL=
REDIS_EVENTS_USERNAME=
REDIS_EVENTS_PASSWORD=
