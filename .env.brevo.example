# Copy to .env.brevo (ignored by git). Uses the Brevo HTTP API, not an SMTP key.
# Sender must be registered/verified in your Brevo account.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=LABSEAT
# Public website used by recipients to load the LABSEAT logo and scoped QR image.
EMAIL_PUBLIC_BASE_URL=
EMAIL_SUPPORT_EMAIL=
# Store the API key in .local/secrets/brevo/api-key (one line, no quotes). Never commit it.
# ECS instead injects BREVO_API_KEY from SSM; do not set both key and key-file.
