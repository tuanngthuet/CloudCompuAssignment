digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="1", dpi=140];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#64748b", arrowsize=0.6];
rooms [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>rooms</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">image_key</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR></TABLE>>];
room_layouts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>room_layouts</B></FONT></TD></TR><TR><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT">uuid PK, FK</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">layout</TD><TD ALIGN="LEFT">jsonb </TD></TR></TABLE>>];
booking_queue_settings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>booking_queue_settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">int PK</TD></TR><TR><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT">bool </TD></TR><TR><TD ALIGN="LEFT">recovery_pending</TD><TD ALIGN="LEFT">bool </TD></TR><TR><TD ALIGN="LEFT">policy_version</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">epoch</TD><TD ALIGN="LEFT">uuid </TD></TR><TR><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">selection_seconds</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">heartbeat_seconds</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">waiting_grace_seconds</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">recovery_not_before</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT">str </TD></TR></TABLE>>];
queue_policy_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>queue_policy_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">actor</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">before</TD><TD ALIGN="LEFT">jsonb </TD></TR><TR><TD ALIGN="LEFT">after</TD><TD ALIGN="LEFT">jsonb </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
rooms -> room_layouts [label="room_id", taillabel="1", headlabel="0..1", style="solid"];
}