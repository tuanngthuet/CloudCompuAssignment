digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="1", dpi=140];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#64748b", arrowsize=0.6];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">avatar_key</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">cccd</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email_verified_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">pending_email</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">email_version</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">last_activity_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">anonymization_notice_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">anonymization_notice_delivered_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR></TABLE>>];
reservations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>reservations</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">slot</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">seat_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">hold_expires_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">ticket_code</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">checked_in_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR></TABLE>>];
outbox_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>outbox_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">attempts</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">available_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
notification_deliveries [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>notification_deliveries</B></FONT></TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT">uuid PK, FK</TD></TR><TR><TD ALIGN="LEFT">notification_type</TD><TD ALIGN="LEFT">str PK</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">provider_message_id</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR></TABLE>>];
email_jobs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>email_jobs</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT">uuid FK &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">recipient</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">context</TD><TD ALIGN="LEFT">jsonb </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">provider_message_id</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">send_started_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">last_attempt_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">provider_event_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">attempts</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">last_error</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
webhook_inbox [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>webhook_inbox</B></FONT></TD></TR><TR><TD ALIGN="LEFT">fingerprint</TD><TD ALIGN="LEFT">str PK</TD></TR><TR><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid FK &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">provider_message_id</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">event</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">processed_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR></TABLE>>];
users -> reservations [label="user_id", taillabel="1", headlabel="0..N", style="dashed"];
reservations -> outbox_events [label="reservation_id", taillabel="1", headlabel="0..N", style="dashed"];
reservations -> notification_deliveries [label="reservation_id", taillabel="1", headlabel="0..N", style="solid"];
users -> email_jobs [label="user_id", taillabel="1", headlabel="0..N", style="dashed"];
reservations -> email_jobs [label="reservation_id", taillabel="0..1", headlabel="0..N", style="dashed"];
email_jobs -> webhook_inbox [label="job_id", taillabel="0..1", headlabel="0..N", style="dashed"];
}