digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="1", dpi=140];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#64748b", arrowsize=0.6];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">avatar_key</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">cccd</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email_verified_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">pending_email</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">email_version</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">last_activity_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">anonymization_notice_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">anonymization_notice_delivered_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR></TABLE>>];
login_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>login_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">csrf_hash</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
auth_challenges [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>auth_challenges</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email_version</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">nonce</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">consumed_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
idempotency_records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>idempotency_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid PK, FK</TD></TR><TR><TD ALIGN="LEFT">key_hash</TD><TD ALIGN="LEFT">str PK</TD></TR><TR><TD ALIGN="LEFT">fingerprint</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">response</TD><TD ALIGN="LEFT">jsonb </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
staff_assignments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>staff_assignments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT">uuid PK, FK</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid PK, FK</TD></TR><TR><TD ALIGN="LEFT">assigned_by</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
lab_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>lab_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">uuid FK &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">checkin_enabled</TD><TD ALIGN="LEFT">bool </TD></TR><TR><TD ALIGN="LEFT">checkin_close_mode</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">checkin_closes_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">checkin_revision</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">open_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">close_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">start_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">end_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
users -> login_sessions [label="user_id", taillabel="1", headlabel="0..N", style="dashed"];
users -> idempotency_records [label="user_id", taillabel="1", headlabel="0..N", style="solid"];
lab_sessions -> staff_assignments [label="session_id", taillabel="1", headlabel="0..N", style="solid"];
users -> staff_assignments [label="user_id", taillabel="1", headlabel="0..N", style="solid"];
users -> staff_assignments [label="assigned_by", taillabel="1", headlabel="0..N", style="dashed"];
users -> auth_challenges [label="user_id", taillabel="1", headlabel="0..N", style="dashed"];
}