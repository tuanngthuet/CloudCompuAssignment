digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="1", dpi=140];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#64748b", arrowsize=0.6];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">avatar_key</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">cccd</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">email_verified_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">pending_email</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">email_version</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">last_activity_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">anonymization_notice_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">anonymization_notice_delivered_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR></TABLE>>];
reservations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>reservations</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">slot</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">seat_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">hold_expires_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">ticket_code</TD><TD ALIGN="LEFT">str &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">checked_in_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR></TABLE>>];
lab_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>lab_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT">uuid FK &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">checkin_enabled</TD><TD ALIGN="LEFT">bool </TD></TR><TR><TD ALIGN="LEFT">checkin_close_mode</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">checkin_closes_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">checkin_revision</TD><TD ALIGN="LEFT">int </TD></TR><TR><TD ALIGN="LEFT">open_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">close_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">start_at</TD><TD ALIGN="LEFT">timestamp </TD></TR><TR><TD ALIGN="LEFT">end_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
audit_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>audit_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
checkin_policy_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>checkin_policy_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">uuid FK &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT">bool </TD></TR><TR><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">effective_at</TD><TD ALIGN="LEFT">timestamp &quot;nullable&quot;</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
admin_audits [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#193751"><FONT COLOR="white"><B>admin_audits</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">str </TD></TR><TR><TD ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid </TD></TR><TR><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT">jsonb </TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp </TD></TR></TABLE>>];
users -> reservations [label="user_id", taillabel="1", headlabel="0..N", style="dashed"];
lab_sessions -> reservations [label="session_id", taillabel="1", headlabel="0..N", style="dashed"];
users -> audit_events [label="actor_id", taillabel="1", headlabel="0..N", style="dashed"];
reservations -> audit_events [label="reservation_id", taillabel="1", headlabel="0..N", style="dashed"];
lab_sessions -> checkin_policy_events [label="session_id", taillabel="1", headlabel="0..N", style="dashed"];
users -> checkin_policy_events [label="actor_id", taillabel="0..1", headlabel="0..N", style="dashed"];
users -> admin_audits [label="actor_id", taillabel="1", headlabel="0..N", style="dashed"];
}